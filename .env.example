# Copy to .env and adjust. Nothing here is a real credential.

# --- Business ---------------------------------------------------------------
BUSINESS_NAME="Spoke & Chain Cycle Works"
DATABASE_PATH=data/assistant.db

# --- Language model ---------------------------------------------------------
# "anthropic" calls Claude. "fake" answers extractively from the documents
# with no network access, which is useful for local trials.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_OUTPUT_TOKENS=1024

# --- Ingestion and retrieval ------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Minimum relevance (0-1) for a chunk to count as evidence. Below it, the
# question is handed to a human instead of being answered.
MIN_RELEVANCE=0.4
# "fastembed" needs: pip install 'ai-support-assistant[embeddings]'
EMBEDDINGS_BACKEND=none
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Conversation limits ----------------------------------------------------
MEMORY_TURNS=6
MAX_INPUT_CHARS=1000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
HANDOFF_AFTER_FAILURES=2

# --- Human handoff ----------------------------------------------------------
# Telegram notifications (and delivery of operator replies to Telegram users).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
# Email notifications. Both SMTP_HOST and OPERATOR_EMAIL are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
OPERATOR_EMAIL=

# --- HTTP API ---------------------------------------------------------------
# Admin endpoints are disabled until a token is set. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=
HOST=127.0.0.1
PORT=8000

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# "json" for production, "console" for development.
LOG_FORMAT=json
